# Clerk publishable key (dashboard -> API keys)
#
# Esto es solo para desarrollo local. Las builds de EAS NO leen este fichero:
# development y preview llevan la pk_test_ escrita en eas.json, y production la
# recibe de EAS Environment Variables (perfil con "environment": "production"),
# no del repo. Antes de la primera build de producción, una vez:
#   eas env:create --environment production \
#     --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_live_...
# Sin esa variable la clave llega vacía y Clerk falla al arrancar — a propósito:
# es preferible a que la app de la store autentique contra la instancia de test.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# Backend API URL. SIN "/api" al final: el cliente lo añade solo
# (src/lib/api.ts hace `${API_URL}/api${path}`); ponerlo aquí da /api/api/...
# Dev local: http://localhost:3000 · Producción: https://true-rep-backend.vercel.app
EXPO_PUBLIC_API_URL="https://true-rep-backend.vercel.app"

# OPCIONAL. Solo para los leaderboards en tiempo real (alcance diferido).
# Es la clave PUBLISHABLE/anon de Supabase, NUNCA la secret: este valor se
# incrusta en el bundle de la app, y la secret salta el Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=""
EXPO_PUBLIC_SUPABASE_ANON_KEY=""
