{
  "expo": {
    "name": "TrueRep",
    "slug": "truerep",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "truerep",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.truerep.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "TrueRep uses the camera to record exercise videos for AI form feedback.",
        "NSPhotoLibraryUsageDescription": "TrueRep accesses your photo library to upload exercise videos."
      }
    },
    "android": {
      "package": "com.truerep.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "72163ad1-4116-41da-8a3d-d36cbb5a8da6"
      }
    }
  }
}
