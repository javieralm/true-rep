datasource db {
  provider  = "postgresql"
  // En serverless cada instancia abre sus propias conexiones, así que
  // DATABASE_URL apunta al pooler de Supabase (puerto 6543, pgbouncer) para no
  // agotar el límite de conexiones. Pero las migraciones no pueden pasar por
  // pgbouncer en modo transaction: DIRECT_URL es la conexión directa (5432) y
  // es la que usa `prisma migrate`.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                       String             @id @default(cuid())
  email                    String             @unique
  clerk_id                 String             @unique
  username                 String
  avatar_url               String?
  role                     Role               @default(USER)
  is_superadmin            Boolean            @default(false) // promueve trainers desde /admin
  subscription_status      SubscriptionStatus @default(FREE)
  subscription_id          String?
  stripe_customer_id       String? // reusado entre checkouts para no fragmentar el historial de pago
  subscription_plan        SubscriptionPlan?
  subscription_expires_at  DateTime?
  xp                       Int                @default(0)
  streak                   Int                @default(0)
  streak_last_workout_date DateTime?
  reminder_enabled         Boolean            @default(true)
  reminder_hour            Int                @default(8) // hora local 0-23
  timezone                 String             @default("Europe/Madrid")
  last_reminder_sent_at    DateTime?
  created_at               DateTime           @default(now())
  updated_at               DateTime           @updatedAt

  routines               Routine[]
  workouts               Workout[]
  achievements           UserAchievement[]
  challenge_participants ChallengeParticipant[]
  video_feedback         VideoFeedback[]
  exercises              Exercise[]
  programs               Program[]
  program_assignments    ProgramAssignment[]
  push_tokens            PushToken[]

  @@index([xp])
  @@index([subscription_id])
  @@map("users")
}

model Routine {
  id                String     @id @default(cuid())
  trainer_id        String
  // Restrict, no Cascade: borrar un trainer NUNCA debe arrastrar en cascada
  // el historial de workouts de sus suscriptores (ver Workout.routine abajo).
  // El webhook de Clerk (user.deleted) anonimiza al trainer en vez de
  // borrarlo cuando tiene rutinas — ver apps/backend/src/app/api/webhooks/clerk/route.ts.
  trainer           User       @relation(fields: [trainer_id], references: [id], onDelete: Restrict)
  title             String
  description       String     @db.Text
  difficulty        Difficulty
  duration_minutes  Int
  exercises         Json // Array: [{id, name, reps/duration_seconds, technique_video_url, description}]
  preview_video_url String?
  is_published      Boolean    @default(false)
  deleted_at        DateTime? // soft delete
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt

  workouts      Workout[]
  challenges    Challenge[]
  program_items ProgramItem[]

  @@index([trainer_id])
  @@index([difficulty, is_published])
  @@map("routines")
}

enum ExerciseMeasure {
  reps
  seconds
}

model Exercise {
  id            String          @id @default(cuid())
  trainer_id    String
  trainer       User            @relation(fields: [trainer_id], references: [id], onDelete: Cascade)
  name          String
  measure       ExerciseMeasure @default(reps) // posturales (L-sit, plancha) van por segundos
  muscle_group  String? // "Tracción", "Empuje", "Pierna", "Core"...
  equipment     String? // "Barra de dominadas", "Anillas", "Goma elástica"...
  video_url     String?
  thumbnail_url String?
  description   String?         @db.Text
  deleted_at    DateTime? // soft delete
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt

  @@index([trainer_id, name])
  @@map("exercises")
}

model Program {
  id          String    @id @default(cuid())
  trainer_id  String
  trainer     User      @relation(fields: [trainer_id], references: [id], onDelete: Cascade)
  name        String
  description String?   @db.Text
  deleted_at  DateTime? // soft delete
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  items       ProgramItem[]
  assignments ProgramAssignment[]

  @@index([trainer_id])
  @@map("programs")
}

model ProgramItem {
  id         String          @id @default(cuid())
  program_id String
  program    Program         @relation(fields: [program_id], references: [id], onDelete: Cascade)
  week       Int // 1-based
  day        Int // 1-7 (lunes-domingo)
  order      Int             @default(0)
  type       ProgramItemType @default(ROUTINE)
  routine_id String? // solo tareas ROUTINE
  routine    Routine?        @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  data       Json? // payload por tipo: {title, body, url, mode, location, time}

  @@index([program_id, week, day])
  @@map("program_items")
}

model ProgramAssignment {
  id         String   @id @default(cuid())
  program_id String
  program    Program  @relation(fields: [program_id], references: [id], onDelete: Cascade)
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  start_date DateTime // lunes de la semana 1
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@unique([user_id, program_id])
  @@index([user_id, is_active])
  @@map("program_assignments")
}

model Workout {
  id                  String    @id @default(cuid())
  user_id             String
  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  routine_id          String
  routine             Routine   @relation(fields: [routine_id], references: [id], onDelete: Cascade)
  completed_at        DateTime
  duration_minutes    Int
  exercises_completed Json // Array: [{exercise_id, reps_done, weight_kg?, felt_like}]
  xp_earned           Int
  notes               String?   @db.Text
  trainer_feedback    String?   @db.Text // comentario del coach (Fase 5)
  feedback_at         DateTime?
  created_at          DateTime  @default(now())
  // Idempotencia real: el cliente envía un UUID por intento de guardado; un
  // reintento con la MISMA key nunca duplica el workout, sin depender de una
  // ventana de tiempo.
  idempotency_key     String

  @@unique([user_id, idempotency_key])
  @@index([user_id, completed_at])
  @@index([routine_id])
  @@map("workouts")
}

model Achievement {
  id               String               @id @default(cuid())
  name             String
  description      String               @db.Text
  icon_url         String
  unlock_condition AchievementCondition @unique
  created_at       DateTime             @default(now())

  user_achievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id             String      @id @default(cuid())
  user_id        String
  user           User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  achievement_id String
  achievement    Achievement @relation(fields: [achievement_id], references: [id], onDelete: Cascade)
  unlocked_at    DateTime    @default(now())

  @@unique([user_id, achievement_id])
  @@map("user_achievements")
}

model Challenge {
  id               String     @id @default(cuid())
  title            String
  description      String     @db.Text
  routine_id       String?
  routine          Routine?   @relation(fields: [routine_id], references: [id], onDelete: SetNull)
  difficulty       Difficulty
  starts_at        DateTime
  ends_at          DateTime
  max_participants Int?
  xp_reward        Int
  created_at       DateTime   @default(now())

  participants ChallengeParticipant[]

  @@index([starts_at, ends_at])
  @@map("challenges")
}

model ChallengeParticipant {
  id           String    @id @default(cuid())
  challenge_id String
  challenge    Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  joined_at    DateTime  @default(now())
  completed_at DateTime?
  rank         Int?

  @@unique([challenge_id, user_id])
  @@index([challenge_id, completed_at])
  @@index([user_id, completed_at])
  @@map("challenge_participants")
}

model VideoFeedback {
  id              String         @id @default(cuid())
  user_id         String
  user            User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  exercise_name   String
  video_url       String
  analysis_status AnalysisStatus @default(PENDING)
  feedback_text   String?        @db.Text
  created_at      DateTime       @default(now())
  analyzed_at     DateTime?

  @@index([user_id])
  @@map("video_feedback")
}

model PushToken {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token      String   @unique // ExponentPushToken[...]
  platform   String? // 'ios' | 'android'
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([user_id, is_active])
  @@map("push_tokens")
}

enum ProgramItemType {
  ROUTINE // rutina/workout
  MESSAGE // mensaje programado (push el día N)
  VIDEO // contenido de vídeo
  NOTE // nota/actividad libre (cardio, movilidad…)
  SESSION // sesión presencial u online
}

enum Role {
  USER
  TRAINER
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  CANCELLED
}

enum SubscriptionPlan {
  BASE
  PREMIUM
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AchievementCondition {
  FIRST_WORKOUT
  STREAK_7
  STREAK_30
  XP_100
  XP_500
  COMPLETE_ROUTINE
  CHALLENGE_WIN
}

enum AnalysisStatus {
  PENDING_TRAINER_REVIEW // el trainer no ha aprobado el análisis automático todavía
  PENDING
  COMPLETED
  FAILED
}
