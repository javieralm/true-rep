# REQUIRED to boot at all — every request touches the DB.
# Supabase PostgreSQL (Connection string, Prisma format)
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# REQUIRED to boot at all — every protected route calls requireUser().
# Clerk (dashboard -> API keys)
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET=""

# REQUIRED only for the subscription/paywall flow (checkout, portal, webhook).
# Everything else works without these.
# Stripe (dashboard -> API keys / Webhooks)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_BASE=""
STRIPE_PRICE_PREMIUM=""

# REQUIRED only for video upload/feedback routes (video-feedback/*).
# Cloudinary (dashboard -> Settings)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# REQUIRED only for AI posture analysis (video-feedback/analyze).
# OpenAI (platform -> API keys)
OPENAI_API_KEY=""

# REQUIRED only for real-time leaderboard/challenge updates (deferred scope, see TODOS.md).
# Supabase Realtime (project settings -> API)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# REQUIRED only for the cron reminders route (deferred scope, see TODOS.md).
# Cron (Vercel lo envía como Bearer token a /api/cron/*)
CRON_SECRET=""
