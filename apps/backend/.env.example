# ─────────────────────────────────────────────────────────────────────────────
# EN VERCEL: el tipo de cada variable importa y no es por "cómo de secreta es",
# sino por DÓNDE se consume. Las marcadas como "Sensitive" NO se inyectan
# durante el build, solo en runtime:
#
#   · Tipo Config (obligatorio)  -> CLERK_SECRET_KEY (la usa middleware.ts, que
#     corre en Edge y necesita el valor incrustado en build) y toda NEXT_PUBLIC_*
#     (viajan al bundle del navegador).
#   · Tipo Sensitive (vale)      -> el resto: solo las leen rutas /api/* que se
#     ejecutan como funciones serverless y sí leen el entorno en runtime.
#
# Ponerlas todas como Sensitive hace que el build falle con "Missing
# publishableKey" y, si pasa el build, que el middleware devuelva 500 en TODAS
# las rutas con "Missing secretKey". Ojo además: una variable Sensitive es de
# solo escritura, Vercel no te deja volver a leer su valor nunca.
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED to boot at all — every request touches the DB.
# Supabase -> Connect -> ORMs/Prisma. En serverless usa el POOLER (puerto 6543):
# cada instancia de función abre sus propias conexiones y la conexión directa
# se queda sin cupo bajo carga.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"

# REQUIRED para `prisma migrate deploy`. Conexión DIRECTA (puerto 5432): las
# migraciones no pueden pasar por pgbouncer en modo transaction.
# En runtime no se usa, así que en Vercel puedes dejarla solo si vas a migrar
# desde allí; si migras desde tu máquina, basta con tenerla en local.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# REQUIRED to boot at all — every protected route calls requireUser().
# Clerk (dashboard -> API keys)
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_WEBHOOK_SECRET=""

# REQUIRED only for the subscription/paywall flow (checkout, portal, webhook).
# Everything else works without these.
# Stripe (dashboard -> API keys / Webhooks)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Destino de eventos de "Cuentas conectadas" (suscripciones de los clientes a su entrenador)
STRIPE_CONNECT_WEBHOOK_SECRET=""

# REQUIRED only for video upload/feedback routes (video-feedback/*).
# Cloudinary (dashboard -> Settings)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# REQUIRED only for AI posture analysis (video-feedback/analyze).
# OpenAI (platform -> API keys)
OPENAI_API_KEY=""

# NO hacen falta en el backend: no usa el cliente JS de Supabase (habla con
# Postgres por Prisma/DATABASE_URL). El único que las consume es el móvil, con
# prefijo EXPO_PUBLIC_, y solo para los leaderboards en tiempo real (diferido).
# Si algún día se usan: va la clave PUBLISHABLE/anon, NUNCA la secret — el
# prefijo público la incrusta en el bundle y la secret salta el Row Level
# Security, o sea acceso total a la base de datos para cualquiera.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# App. En local, localhost. En Vercel DEBE ser el dominio real
# (https://true-rep-backend.vercel.app): de aquí salen las URLs de retorno del
# checkout y del portal de Stripe, así que con localhost el pago vuelve a una
# página que el usuario no tiene levantada.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# REQUIRED only for the cron reminders route (deferred scope, see TODOS.md).
# Cron (Vercel lo envía como Bearer token a /api/cron/*)
CRON_SECRET=""

# OPCIONAL. Interruptor del auto-complete de retos en POST /api/workouts/log.
# Sin definir = activado. Ponlo a "false" para apagarlo sin tocar código si
# llega a degradar el loop de logging (alcance diferido, ver TODOS.md).
FEATURE_CHALLENGES_ENABLED=""
